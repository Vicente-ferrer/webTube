<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="cz.martykan.webtube.MainActivity">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/appWindow"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Behind the status bar; its height comes from the window insets -->
            <View
                android:id="@+id/statusBarSpace"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@color/colorPrimary" />

            <RelativeLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/statusBarSpace">

                <!-- See MiniPlayerController -->
                <FrameLayout
                    android:id="@+id/webViewFrame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/bottomBar"
                    android:layout_alignParentTop="true">

                    <!-- Every YouTube page but videos -->
                    <cz.martykan.webtube.WebTubeWebView
                        android:id="@+id/browserWebView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Videos, over the browser; shrinks into the mini player -->
                    <cz.martykan.webtube.WebTubeWebView
                        android:id="@+id/playerWebView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="bottom|start"
                        android:visibility="gone" />

                    <!-- Over the shrunk player WebView, which shows through on the left -->
                    <LinearLayout
                        android:id="@+id/miniPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/mini_player_height"
                        android:layout_gravity="bottom"
                        android:clickable="true"
                        android:contentDescription="@string/expandPlayer"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/mini_player_progress_height"
                            android:background="@color/miniPlayerTrack">

                            <View
                                android:id="@+id/miniPlayerProgress"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/colorAccent" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="@dimen/mini_player_video_width"
                                android:layout_height="match_parent" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@color/miniPlayerBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingLeft="12dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/miniPlayerTitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:textColor="?android:attr/textColorPrimary"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:id="@+id/miniPlayerChannel"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:textColor="?android:attr/textColorSecondary"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <ImageButton
                                    android:id="@+id/miniPlayerPlayPause"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/pause"
                                    android:src="@drawable/pause"
                                    app:tint="?android:attr/textColorPrimary" />

                                <ImageButton
                                    android:id="@+id/miniPlayerClose"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/close"
                                    android:src="@drawable/close"
                                    app:tint="?android:attr/textColorPrimary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <!-- Also drawn behind the navigation bar -->
                <RelativeLayout
                    android:id="@+id/bottomBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bottom_bar_height"
                    android:layout_alignParentBottom="true"
                    android:background="@color/colorPrimary">

                    <androidx.appcompat.widget.ActionMenuView
                        android:id="@+id/menu_main"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/actionBarSize"
                        android:layout_alignParentBottom="true"
                        android:layout_gravity="center" />


                    <ProgressBar
                        android:id="@+id/progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/menu_main"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentLeft="true"
                        android:layout_marginTop="-7dp"
                        android:layout_marginBottom="-7dp"
                        android:backgroundTint="@android:color/transparent"
                        android:indeterminateTint="@color/white"
                        android:progress="50"
                        android:progressTint="@color/white"
                        tools:targetApi="lollipop" />
                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/bookmarks_panel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            app:headerLayout="@layout/bookmarks_header"
            app:menu="@menu/bookmarks" />

    </androidx.drawerlayout.widget.DrawerLayout>

    <FrameLayout
        android:id="@+id/customViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:background="#000"
        android:clickable="false"
        android:visibility="gone" />

</RelativeLayout>
